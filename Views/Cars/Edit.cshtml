@model CarLeasingSystem.Models.Car

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Car</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="form-group mb-3">
                <label asp-for="Make" class="control-label"></label>
                <input asp-for="Make" class="form-control" />
            </div>
    
            <div class="form-group mb-3">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="LicensePlate" class="control-label"></label>
                <input asp-for="LicensePlate" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="DailyRate" class="control-label"></label>
                <input asp-for="DailyRate" class="form-control" />
            </div>

            <div class="form-group mb-3 form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsAvailable" /> @Html.DisplayNameFor(model => model.IsAvailable)
                </label>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Replace Image</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <div class="col-md-4 offset-md-1">
        <label>Current Image</label>
        <div class="card mt-2">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-car.png" : Model.ImageUrl)" 
                 class="card-img-top" alt="Car Image" style="height: 200px; object-fit: cover;">
        </div>
    </div>
</div>
