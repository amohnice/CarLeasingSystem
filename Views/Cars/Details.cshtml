@model CarLeasingSystem.Models.Car

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mb-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/cars/default-car.png" : Model.ImageUrl)" 
                 class="img-fluid rounded shadow-sm" 
                 alt="@Model.Make @Model.Model">
        </div>

        <div class="col-md-6">
            <h1 class="display-5 fw-bold">@Model.Make @Model.Model</h1>
            <p class="text-muted fs-4">Plate: @Model.LicensePlate</p>
            
            <div class="my-4">
                <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger") fs-6 p-2">
                    @(Model.IsAvailable ? "Available Now" : "Currently Unavailable")
                </span>
            </div>

            <h2 class="text-primary fw-bold mb-4">KSh @Model.DailyRate.ToString("N0") <small class="text-muted fs-5">/ per day</small></h2>

            <div class="d-grid gap-2 d-md-block">
                @if (Model.IsAvailable)
                {
                    <a asp-controller="Bookings" asp-action="Create" asp-route-carId="@Model.Id" 
                       class="btn btn-primary btn-lg px-5">Book Now</a>
                }
                
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">Back to Fleet</a>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="mt-5 border-top pt-3">
                    <h5 class="text-secondary">Admin Actions</h5>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-sm">Edit Car</a>
                </div>
            }
        </div>
    </div>
</div>
