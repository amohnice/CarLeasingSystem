@model CarLeasingSystem.Models.Car

@{
    // Check if dates were passed from the SearchResults page
    var start = ViewData["StartDate"];
    var end = ViewData["EndDate"];
}

<div class="card h-100 shadow-sm border-0">
    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/cars/default-car.png" : Model.ImageUrl)" 
         class="card-img-top" alt="@Model.Make @Model.Model" style="height: 200px; object-fit: cover;">

    <div class="card-header bg-transparent border-0 d-flex justify-content-end">
        <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger")">
            @(Model.IsAvailable ? "Available" : "Unavailable")
        </span>
    </div>

    <div class="card-body">
        <h5 class="card-title">@Model.Make @Model.Model</h5>
        <p class="card-text text-muted mb-1">Plate: @Model.LicensePlate</p>
        <h3 class="card-text text-primary">Kes @Model.DailyRate<small class="text-muted fs-6">/day</small></h3>
    </div>

    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
        <div class="d-grid gap-2">
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">View Details</a>
            
            @if (Model.IsAvailable)
            {
                <a asp-controller="Bookings" asp-action="Create" 
                   asp-route-carId="@Model.Id" 
                   asp-route-start="@start" 
                   asp-route-end="@end" 
                   class="btn btn-primary">Book Now</a>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="btn-group mt-2">
                    <a asp-controller="Cars" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                    <a asp-controller="Cars" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            }
        </div>
    </div>
</div>
